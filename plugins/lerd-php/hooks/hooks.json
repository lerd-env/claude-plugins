{
  "description": "Stops the first grep for a PHP symbol in a session so Claude asks the language server instead.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lsp-reminder.sh\"", "timeout": 5 }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lsp-reminder.sh\"", "if": "Bash(grep *)", "timeout": 5 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lsp-reminder.sh\"", "if": "Bash(rg *)", "timeout": 5 }
        ]
      }
    ]
  }
}
